@namespace Boxty.ClientApp.Pages.Components
@using Boxty.ClientApp.Pages.Components.Forms
@using Boxty.ClientBase.Components
@using Boxty.ClientBase.Enums
@using Boxty.SharedApp.DTOs.Settings
@using System.Net.Http.Json
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject HttpClient Http
@inject ISnackbar Snackbar

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (loadError != null)
{
    <MudAlert Severity="MudBlazor.Severity.Error">@loadError</MudAlert>
}
else if (Model != null)
{
    <CrudForm T="SmtpConfigDto" Model="Model" FormMode="FormMode" IsModal="false"
              OnAdd="HandleCreated">
        <ChildContent>
            <SmtpConfigForm />
        </ChildContent>
    </CrudForm>
    <MudButton OnClick="SendTestEmail" Disabled="isSendingTest"
               Color="Color.Primary" Variant="Variant.Outlined" Class="mt-2">
        Send Test Email
    </MudButton>
}

@code {
    [Parameter] public SmtpConfigDto? Model { get; set; }
    [Parameter] public FormModeEnum FormMode { get; set; } = FormModeEnum.Create;

    private bool isLoading = true;
    private string? loadError;
    private bool isSendingTest;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Model != null)
            {
                return;
            }

            using var response = await Http.GetAsync("api/smtpconfig/getall");
            response.EnsureSuccessStatusCode();
            var configurations = response.StatusCode == HttpStatusCode.NoContent
                ? new List<SmtpConfigDto>()
                : await response.Content.ReadFromJsonAsync<List<SmtpConfigDto>>();
            if (configurations == null)
            {
                loadError = "The server returned an invalid SMTP settings response.";
                return;
            }

            if (configurations.Count > 1)
            {
                loadError = "Multiple SMTP configurations were found. A single configuration is required for this form.";
                return;
            }

            Model = configurations.SingleOrDefault() ?? new SmtpConfigDto();
            FormMode = configurations.Count == 1 ? FormModeEnum.Edit : FormModeEnum.Create;
        }
        catch (HttpRequestException)
        {
            loadError = "Unable to load SMTP settings. Please reload the page to try again.";
        }
        catch (JsonException)
        {
            loadError = "The server returned an invalid SMTP settings response.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandleCreated(SmtpConfigDto model) => FormMode = FormModeEnum.Edit;

    private async Task SendTestEmail()
    {
        if (isSendingTest || Model == null)
        {
            return;
        }
        isSendingTest = true;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/smtpconfig/testemail",
                new TestSmtpEmailRequest(Model));
            var message = response.IsSuccessStatusCode
                ? "The SMTP server accepted the test email. Check your inbox and spam folder."
                : response.StatusCode == HttpStatusCode.BadRequest
                    ? "Check the required SMTP fields and sender email address."
                    : "Unable to send the test email. Check your SMTP settings and permissions.";
            Snackbar.Add(message, response.IsSuccessStatusCode ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch (AccessTokenNotAvailableException)
        {
            Snackbar.Add("Your session has expired. Please log in again.", MudBlazor.Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Unable to contact the server to send the test email.", MudBlazor.Severity.Error);
        }
        finally
        {
            isSendingTest = false;
        }
    }
}
