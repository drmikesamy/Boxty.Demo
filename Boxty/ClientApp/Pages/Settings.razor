@page "/settings"
@using MudBlazor
@using Boxty.SharedBase.DTOs.Auth;
@using Boxty.SharedApp.DTOs.UserManagement
@using Boxty.ClientApp.Pages.Components.Grids
@using Boxty.ClientBase.Services
@using Boxty.SharedApp.Extensions

@inject ICrudService<RoleDto> RoleCrudService

<MudGrid>
    <MudItem xs="12">
        <MudText Typo="Typo.h1">Settings</MudText>
    </MudItem>
</MudGrid>

<MudDialog @bind-Visible="addRoleDialogOpen" Options="@(new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Add New Role</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="newRoleName"
                      Label="Role Name"
                      Variant="Variant.Outlined"
                      Required="true"
                      Immediate="true"
                      RequiredError="Role name is required!" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => addRoleDialogOpen = false">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="HandleAddRole" Disabled="@string.IsNullOrWhiteSpace(newRoleName)">Save</MudButton>
    </DialogActions>
</MudDialog>

<MudTabs Elevation="2" Rounded="true" PanelClass="pa-4">
    <MudTabPanel Text="Authorization">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <div>
                <MudText Typo="Typo.h6">Role &amp; Permission Management</MudText>
                <MudText Typo="Typo.body2">Roles are stored in Boxty and synchronized to Keycloak through the existing role endpoints.</MudText>
            </div>
            <MudStack Row="true" Spacing="2">
                <MudButton OnClick="LoadAuthorizationModelAsync" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh">
                    Refresh
                </MudButton>
                <MudButton OnClick="OpenAddRoleDialog" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                    Add Role
                </MudButton>
            </MudStack>
        </MudStack>

        @if (isLoading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        }
        else if (!roles.Any())
        {
            <MudAlert Severity="Severity.Info">No roles were returned from the authorization service.</MudAlert>
        }
        else
        {
            <MudTabs Elevation="0" Rounded="true" PanelClass="pa-4">
                @foreach (var role in roles.OrderBy(role => role.GetAuthDisplayName()))
                {
                    <MudTabPanel Text="@role.GetAuthDisplayName()">
                        <MudPaper Class="pa-4 d-flex flex-column">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-3">
                                <div>
                                    <MudText Typo="Typo.h6">@role.GetAuthDisplayName()</MudText>
                                    <MudText Typo="Typo.caption">@role.Name</MudText>
                                </div>
                                <MudChip T="string" Text="@($"{role.Permissions.Count} permissions")" Size="Size.Small" Color="Color.Primary" />
                            </MudStack>

                            @if (role.Permissions.Any())
                            {
                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
                                    @foreach (var permission in role.Permissions.OrderBy(permission => permission.Name))
                                    {
                                        <MudChip T="string" Text="@permission.Name" Color="@GetPermissionChipColor(permission.Name)" Size="Size.Small" />
                                    }
                                </MudStack>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="mb-3">No permissions assigned to this role.</MudText>
                            }

                            <MudStack Row="true" Spacing="2">
                                <MudButton OnClick="() => OpenManagePermissionsDialog(role)" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit">
                                    Permissions
                                </MudButton>
                                <MudButton OnClick="() => HandleDeleteRole(role)"
                                           Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.Delete"
                                           Disabled="@IsProtectedRole(role.Name)">
                                    Delete
                                </MudButton>
                            </MudStack>
                        </MudPaper>
                    </MudTabPanel>
                }
            </MudTabs>
        }
    </MudTabPanel>
</MudTabs>

<MudDialog @bind-Visible="managePermissionsDialogOpen" Options="@(new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Manage Permissions for @(currentRoleForPermissionDialog?.GetAuthDisplayName())</MudText>
    </TitleContent>
    <DialogContent>
        @if (allPermissions.Any())
        {
            <MudText Typo="Typo.subtitle2" Class="mb-2">Select permissions:</MudText>
            <MudPaper Class="overflow-y-auto" MaxHeight="300">
                <MudList T="PermissionDto"
                         SelectedValues="selectedPermissionsInDialog"
                         SelectedValuesChanged="HandleSelectedPermissionsChanged"
                         SelectionMode="SelectionMode.MultiSelection"
                         CheckBoxColor="Color.Primary">
                    @foreach (var perm in allPermissions.Where(p => !p.Name.Contains("BaseEntity")).OrderBy(p => p.Name))
                    {
                        <MudListItem Value="@perm" Text="@perm.Name" />
                    }
                </MudList>
            </MudPaper>
        }
        else
        {
            <MudText>No permissions available in the system.</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => managePermissionsDialogOpen = false">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="HandleSavePermissionsForRole" Disabled="@(currentRoleForPermissionDialog == null)">Save Changes</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<RoleDto> roles = new();
    private List<PermissionDto> allPermissions = new();
    private bool isLoading;

    private bool addRoleDialogOpen = false;
    private string newRoleName = string.Empty;

    private bool managePermissionsDialogOpen = false;
    private RoleDto? currentRoleForPermissionDialog;
    private List<PermissionDto> selectedPermissionsInDialog = new();


    protected override async Task OnInitializedAsync()
    {
        await LoadAuthorizationModelAsync();
    }

    private async Task LoadAuthorizationModelAsync()
    {
        isLoading = true;

        try
        {
            roles = (await RoleCrudService.GetAllItems(CancellationToken.None)).ToList();

            foreach (var role in roles)
            {
                role.Permissions ??= new List<PermissionDto>();
            }

            allPermissions = roles
                .SelectMany(role => role.Permissions)
                .GroupBy(permission => permission.Name, StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .OrderBy(permission => permission.Name)
                .ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private Color GetPermissionChipColor(string permissionName)
    {
        if (string.IsNullOrWhiteSpace(permissionName)) return Color.Default;

        var nameLower = permissionName.ToLowerInvariant();

        if (nameLower.Contains("create")) return Color.Success;
        if (nameLower.Contains("update")) return Color.Warning;
        if (nameLower.Contains("delete") || nameLower.Contains("remove")) return Color.Error;
        if (nameLower.Contains("view") || nameLower.Contains("read") || nameLower.Contains("get")) return Color.Info; // Using Info as a distinct color for read-like operations. User asked for Grey, Color.Default is an option.

        return Color.Primary;
    }

    private void OpenAddRoleDialog()
    {
        newRoleName = string.Empty;
        addRoleDialogOpen = true;
    }

    private async Task HandleAddRole()
    {
        if (string.IsNullOrWhiteSpace(newRoleName))
        {
            return;
        }
        if (roles.Any(r => r.Name.Equals(newRoleName, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        var normalizedRoleName = newRoleName.Trim().ToLowerInvariant();
        var newRole = new RoleDto { Name = normalizedRoleName, Permissions = new List<PermissionDto>() };

        await RoleCrudService.AddItem(newRole, CancellationToken.None);

        await LoadAuthorizationModelAsync();
        addRoleDialogOpen = false;
        newRoleName = string.Empty;
        StateHasChanged();
    }

    private void OpenManagePermissionsDialog(RoleDto role)
    {
        currentRoleForPermissionDialog = role;
        var currentRolePermissionNames = role.Permissions.Select(p => p.Name).ToHashSet();
        selectedPermissionsInDialog = allPermissions.Where(p => currentRolePermissionNames.Contains(p.Name)).ToList();
        
        managePermissionsDialogOpen = true;
    }

    private void HandleSelectedPermissionsChanged(IEnumerable<PermissionDto> newSelection)
    {
        selectedPermissionsInDialog = newSelection.ToList();
    }

    private async Task HandleSavePermissionsForRole()
    {
        if (currentRoleForPermissionDialog == null)
        {
            return;
        }

        currentRoleForPermissionDialog.Permissions = new List<PermissionDto>(selectedPermissionsInDialog);

        try
        {
            await RoleCrudService.UpdateItem(currentRoleForPermissionDialog, CancellationToken.None);
            await LoadAuthorizationModelAsync();
        }
        finally
        {
            managePermissionsDialogOpen = false;
            StateHasChanged();
        }
    }

    private async Task HandleDeleteRole(RoleDto role)
    {
        if (IsProtectedRole(role.Name))
        {
            return;
        }

        await RoleCrudService.DeleteItem(role.Id, CancellationToken.None);
        await LoadAuthorizationModelAsync();
    }

    private static bool IsProtectedRole(string? roleName)
    {
        return string.Equals(roleName?.Trim(), "administrator", StringComparison.OrdinalIgnoreCase);
    }

}
