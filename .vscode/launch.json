{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to chapp.server",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickRemoteProcess}",
            "justMyCode": true,
            "requireExactSource": false,
            "sourceFileMap": {
                "/app/Boxty/ServerApp": "${workspaceFolder}/Boxty/ServerApp",
                "/app/Boxty/SharedApp": "${workspaceFolder}/Boxty/SharedApp",
                "/app": "${workspaceFolder}"
            },
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "docker",
                "pipeArgs": [
                    "exec",
                    "-i",
                    "chapp.server"
                ],
                "debuggerPath": "/vsdbg/vsdbg",
                "quoteArgs": false
            }
        },
        {
            "name": "Attach to Chrome",
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}/Client"
        },
        {
            "name": "Launch and Debug Standalone Blazor WebAssembly App",
            "type": "blazorwasm",
            "request": "launch",
            "cwd": "${workspaceFolder}/Client"
        },
        {
            "name": "Debug .NET Core in Docker",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickRemoteProcess}",
            "sourceFileMap": {
                "/app": "${workspaceRoot}/"
            },
            "pipeTransport": {
                "pipeCwd": "${workspaceRoot}",
                "pipeProgram": "docker",
                "pipeArgs": [
                    "exec",
                    "-i",
                    "Server"
                ],
                "quoteArgs": false,
                "debuggerPath": "/vsdbg/vsdbg"
            }
        }
    ],
    "inputs": [
        {
            "id": "testFilter",
            "description": "Test filter (e.g., TestMethodName or FullyQualifiedName~TestMethodName)",
            "default": "",
            "type": "promptString"
        }
    ]
}